# Copy to .env in the repository root and edit:
#
#   cp examples/docker/env.example .env
#
# Docker Compose reads .env automatically. It is git-ignored, so it is the
# right place for the webhook URLs and the SMTP password — those are
# credentials, and they must not end up in docker-compose.yml.

# --- Scheduling -------------------------------------------------------------
# How often the check re-runs inside the long-lived container.
SSLSCOUT_INTERVAL=12h

# Local time zone of the container log (the report is always written in UTC).
TZ=UTC

# --- Alerts -----------------------------------------------------------------
# Notification language: en (default) or pt-BR.
SSLSCOUT_LANG=en

# Public URL where the dashboard is published. When set, every alert ends with
# a "Learn more at <url>" line. Leave empty to omit the line. This is the URL
# your users reach, not the container port - so with the reverse proxy in
# front, use https://sslscout.example.com, not http://localhost:8080.
SSLSCOUT_DASHBOARD_URL=

SSLSCOUT_SLACK_WEBHOOK_URL=
SSLSCOUT_TEAMS_WEBHOOK_URL=
SSLSCOUT_SMTP_USERNAME=
SSLSCOUT_SMTP_PASSWORD=

# --- Dashboard --------------------------------------------------------------
# Where nginx is published. Keep the bind on 127.0.0.1 unless the dashboard
# sits behind a reverse proxy with TLS and authentication.
SSLSCOUT_BIND=127.0.0.1
SSLSCOUT_PORT=8080

# Version string baked into the image (shown by `sslscout -version`).
SSLSCOUT_VERSION=docker
