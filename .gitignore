# ---------------------------------------------------------------------------
# Secrets — NEVER commit these
# ---------------------------------------------------------------------------
# config.json holds the SMTP password and the webhook URLs (Slack/Teams).
# Use config.example.json as the template and keep the real file out of Git.
config.json
config.*.json
!config.example.json
*.env
.env
.env.*
!examples/docker/env.example

# ---------------------------------------------------------------------------
# Binaries and build artifacts
# ---------------------------------------------------------------------------
/sslscout
/sslscout.exe
/bin/
/dist/
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html

# ---------------------------------------------------------------------------
# Real domain lists
# ---------------------------------------------------------------------------
# domains.txt is the example list and stays versioned. A production list is an
# inventory of your internal infrastructure (jenkins, git, backup and LDAP
# hosts, non-standard ports) — an attack-surface map. Keep it out of Git under
# one of these names, or point elsewhere with -domains.
domains2.txt
domains.local.txt
domains.prod.txt

# ---------------------------------------------------------------------------
# Output generated at run time
# ---------------------------------------------------------------------------
# report.json is produced on every sslscout run. See the README, section
# "Why report.json is not versioned".
public/report.json

# state.json is the alert history: which domains have a problem right now, and
# when each was last announced. Same sensitivity as the domain list above.
state.json
*.state.json

# ---------------------------------------------------------------------------
# Operating system and editors
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace
